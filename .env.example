# Copy to .env for local runs. On Railway, set these under the service's Variables tab.
# Never commit the real .env.

# HubSpot private app token (read-only is enough). The Regional Interlocks token works.
# Scopes: crm.objects.deals.read, crm.objects.companies.read, crm.objects.owners.read, crm.schemas.deals.read
HUBSPOT_ACCESS_TOKEN=

# Regional Interlocks / RevOps Console: source of the AE roster, team (region) and
# New Business ARR targets (its Inputs tab, /api/config).
REGIONAL_INTERLOCKS_URL=https://regional-interlocks-dashboard-production.up.railway.app
# Same values as that service's DASHBOARD_USERNAME / DASHBOARD_PASSWORD.
REGIONAL_INTERLOCKS_USERNAME=
REGIONAL_INTERLOCKS_PASSWORD=

# Login for this deck. Leave both blank locally to skip the prompt.
RETRO_USERNAME=
RETRO_PASSWORD=

# Where insights are saved. On Railway: attach a Volume and point this at it.
# DATA_DIR=/data

# Optional
# RETRO_REVIEW_QUARTER=FY 26-27 Q2   # the later of the two quarters reviewed (default: last completed quarter)
# MOCK_DATA=1                         # synthetic deals, for trying the layout without HubSpot
# PORT=4000
# FISCAL_YEAR_START_MONTH=5
# HUBSPOT_PORTAL_ID=7712708   # deal names in click-through lists link to HubSpot (default 7712708)
